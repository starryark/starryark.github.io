---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import { profilePage } from '../lib/schema';
import { site } from '../site';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('About page content is missing');
const { Content, headings } = await render(page);
---

<Base title="About" description={page.data.description}>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(profilePage('/about/'))}
  />
  <div class="wrap page-grid">
    <div class="page-content">
      <header class="page-heading"><h1>About</h1></header>
      <div class="prose about-prose"><Content /></div>
      <ContactLinks label="Contact and social profiles" links={site.links} />
    </div>
    <aside class="page-toc" aria-label="On this page">
      <p>On this page</p>
      <nav>
        {
          headings
            .filter((heading) => heading.depth === 2)
            .map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
        }
      </nav>
      <img
        class="about-photo"
        src="/assets/img/painting-480.webp"
        alt="A digital painting by Yangyi Liu: Makise Kurisu from Steins;Gate."
        width="144"
        height="144"
      />
    </aside>
  </div>
</Base>
