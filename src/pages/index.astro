---
import Base from '../layouts/Base.astro';
import BrandIcon from '../components/BrandIcon.astro';
import { publishedPosts, postUrl, shortDate } from '../lib/content';
import { site } from '../site';
const posts = (await publishedPosts()).slice(0, 5);
---

<Base>
  <div class="wrap page-grid home-page">
    <div class="page-content prose">
      <header class="home-intro">
        <h1>{site.name}</h1>
        <p>
          I’m developing agentic systems for bioinformatic analysis at{' '}
          <a href="https://www.amadeusbio.ai">AmadeusBio.ai</a>. I graduated with a B.S. in
          Molecular and Cell Biology from UC San Diego, Class of ’26.
        </p>
      </header>
      <section aria-labelledby="recent-writing">
        <h2 id="recent-writing">Recent writing</h2>
        {
          posts.length ? (
            <div class="recent-posts">
              {posts.map((post) => (
                <article class="recent-post">
                  <h3>
                    <a href={postUrl(post)}>{post.data.title}</a>
                  </h3>
                  <p class="post-date">
                    <time datetime={post.data.date.toISOString()}>{shortDate(post.data.date)}</time>{' '}
                    · {post.data.kind}
                  </p>
                  <p>{post.data.description}</p>
                </article>
              ))}
            </div>
          ) : (
            <p>No published writing yet.</p>
          )
        }
        <p><a href="/writing/">Browse all writing</a></p>
      </section>
      <section aria-labelledby="about-me">
        <h2 id="about-me">About me</h2>
        <p>{site.tagline}</p>
        <p><a href="/about/">More about me</a></p>
      </section>
      <section aria-labelledby="contact">
        <h2 id="contact">Contact</h2>
        <p>You can reach me at <a href={`mailto:${site.email}`}>{site.email}</a>.</p>
        <ul class="social-links" aria-label="Social profiles">
          {
            site.links.map(({ label, href }) => (
              <li>
                <a href={href} rel="me">
                  <BrandIcon name={label} />
                  {label}
                </a>
              </li>
            ))
          }
        </ul>
      </section>
    </div>
    <aside class="page-toc" aria-label="On this page">
      <p>On this page</p>
      <nav>
        <a href="#recent-writing">Recent writing</a>
        <a href="#about-me">About me</a>
        <a href="#contact">Contact</a>
      </nav>
    </aside>
  </div>
</Base>
