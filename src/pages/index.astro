---
import Base from '../layouts/Base.astro';
import ContactLinks from '../components/ContactLinks.astro';
import WorkItem from '../components/WorkItem.astro';
import { profilePage } from '../lib/schema';
import { site } from '../site';
import { profile, work } from '../profile';
const featured = work.filter((item) => item.featured);
const links = site.links.filter((link) => link.primary);
const nowLabel = new Intl.DateTimeFormat('en-US', {
  month: 'long',
  year: 'numeric',
  timeZone: 'UTC',
}).format(new Date(profile.updated));
const toc = [
  ...(profile.now.length ? [{ id: 'now', label: 'Now' }] : []),
  { id: 'selected-work', label: 'Selected work' },
  { id: 'method', label: 'How I work' },
  { id: 'outside-work', label: 'Outside work' },
];
const principles =
  'https://github.com/AmadeusBio-ai/Molecular_Animation/blob/main/docs/principles.md';
---

<Base>
  <script
    slot="head"
    type="application/ld+json"
    is:inline
    set:html={JSON.stringify(profilePage('/'))}
  />
  <div class="wrap page-grid home-page">
    <div class="page-content">
      <header class="home-intro">
        <img
          class="home-portrait"
          src="/assets/img/portrait-320.webp"
          srcset="/assets/img/portrait-320.webp 320w, /assets/img/portrait-640.webp 640w"
          sizes="160px"
          width="160"
          height="160"
          alt="Portrait of Yangyi Liu"
        />
        <h1>{site.name}</h1>
        <p class="home-role">
          Hi! I am interested in where ML intersects Biology
        </p>
        <p>
          I graduated molecular and cell biology at UC San Diego in ~2 years and
           had various teaching, wet and dry lab experiences. Currently I am learning and exploring with the power of frontier models. <a href="/cv/">CV</a>
        </p>
        <p class="home-ask">I'd love to discuss anything, whether it's hobby, research, AI, etc. Send me a message! (Email is the best.) </p>
        <ContactLinks label="Contact and profiles" links={links} />
      </header>

      {
        profile.now.length > 0 && (
          <section class="now" aria-labelledby="now">
            <h2 id="now">
              Now <span class="heading-note">{nowLabel}</span>
            </h2>
            <ul>
              {profile.now.map(({ text, href }) => (
                <li>
                  {text} <a href={href}>Details</a>
                </li>
              ))}
            </ul>
          </section>
        )
      }

      <section aria-labelledby="selected-work">
        <h2 id="selected-work">Selected work</h2>
        <ol class="ledger">
          {featured.map((item) => <WorkItem item={item} showFigure />)}
        </ol>
        <p class="section-more">
          <a href="/work/">All work, with roles, limits, and evidence</a>
        </p>
      </section>

      <section aria-labelledby="method">
        <h2 id="method">How I work with AI agents</h2>
        <blockquote class="method-quote">
          <p>
            “When the data disagrees with the story, show what the data says first. Then add the
            illustrative step and label it.” <cite
              ><a href={principles}>From the Molecular Animation principles</a></cite
            >
          </p>
        </blockquote>
        <dl class="principles">
          <div>
            <dt>Measure the science before building on it.</dt>
            <dd>
              Molecular Animation fetches the PDB entries and measures every claim a film depends
              on, in code, before anything is animated. <a
                href="https://github.com/AmadeusBio-ai/Molecular_Animation/blob/main/docs/workflow.md"
                >Workflow</a
              >
            </dd>
          </div>
          <div>
            <dt>Agents build; checks decide.</dt>
            <dd>
              Every build reports its numerical checks. For the channelrhodopsin film, they cover
              the retinal dihedral path, a salt-bridge distance, the worst bond deviation in the
              morph, the pathway profile, and ion clearance.
            </dd>
          </div>
          <div>
            <dt>Label what is known.</dt>
            <dd>
              Each beat of a film is tagged experimental, illustrative, or symbolic, so what comes
              from a deposited structure stays separate from what is drawn. <a href={principles}
                >Principles</a
              >
            </dd>
          </div>
          <div>
            <dt>Inspect before release.</dt>
            <dd>
              Before the final render, the stills, a preview contact sheet, and motion statistics
              that flag jumps and seams are reviewed. A check command re-renders a shot and compares
              it with the delivered poster.
            </dd>
          </div>
        </dl>
      </section>

      <section aria-labelledby="outside-work">
        <h2 id="outside-work">Outside work</h2>
        <div class="outside-work">
          <figure class="art-figure">
            <img
              src="/assets/img/painting-480.webp"
              srcset="/assets/img/painting-480.webp 480w, /assets/img/painting-960.webp 960w"
              sizes="(max-width: 600px) 100vw, 240px"
              width="240"
              height="240"
              alt="A digital painting by Yangyi Liu: a girl with long brown hair sits hugging her knees in a sunlit corridor."
              loading="lazy"
              decoding="async"
            />
            <figcaption>A digital painting of mine.</figcaption>
          </figure>
          <p>
            I paint and draw, mostly anime-style illustration; a few pieces are on <a
              href="https://www.pixiv.net/users/41472729">Pixiv</a
            >. I also read visual novels and feed the crows on campus. <a href="/about/"
              >More about me</a
            >
          </p>
        </div>
      </section>
    </div>
    <aside class="page-toc" aria-label="On this page">
      <p>On this page</p>
      <nav>
        {toc.map(({ id, label }) => <a href={`#${id}`}>{label}</a>)}
      </nav>
    </aside>
  </div>
</Base>
