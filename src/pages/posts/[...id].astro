---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import {
  publishedPosts,
  postUrl,
  dateLabel,
  readingTime,
  bibtex,
  type Post,
} from '../../lib/content';
import { site } from '../../site';
export async function getStaticPaths() {
  return (await publishedPosts()).map((post) => ({ params: { id: post.id }, props: { post } }));
}
interface Props {
  post: Post;
}
const { post } = Astro.props;
const d = post.data;
const { Content, headings } = await render(post);
const toc = headings.filter((heading) => heading.depth <= 3);
const canonical = new URL(postUrl(post), site.url).href;
const citation = bibtex(post);
const scholarly = d.kind === 'Research';
const artifacts = [
  ...(d.pdf ? [{ label: 'PDF', url: d.pdf }] : []),
  ...(d.doi ? [{ label: 'DOI', url: `https://doi.org/${d.doi}` }] : []),
  ...(d.arxiv ? [{ label: 'arXiv', url: `https://arxiv.org/abs/${d.arxiv}` }] : []),
  ...d.artifacts,
];
const schema = {
  '@context': 'https://schema.org',
  '@type': scholarly ? 'ScholarlyArticle' : 'BlogPosting',
  headline: d.title,
  description: d.description,
  datePublished: d.date.toISOString(),
  dateModified: (d.updated || d.date).toISOString(),
  author: d.authors.map((a) => ({
    '@type': 'Person',
    name: a.name,
    ...(a.name === site.name ? { url: `${site.url}/about/` } : {}),
    ...(a.affiliation ? { affiliation: { '@type': 'Organization', name: a.affiliation } } : {}),
    ...(a.orcid ? { sameAs: a.orcid } : {}),
  })),
  url: canonical,
  mainEntityOfPage: canonical,
  image: new URL(d.image || '/social-card.png', site.url).href,
  ...(d.abstract ? { abstract: d.abstract } : {}),
  ...(d.doi ? { identifier: `https://doi.org/${d.doi}` } : {}),
  ...(d.license ? { license: d.license } : {}),
  ...(d.version ? { version: d.version } : {}),
};
---

<Base title={d.title} description={d.description} image={d.image} article>
  <Fragment slot="head">
    {d.math && <link rel="stylesheet" href="/math/katex.min.css" />}
    <meta property="article:published_time" content={d.date.toISOString()} />
    <meta property="article:modified_time" content={(d.updated || d.date).toISOString()} />
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify(schema).replace(/</g, '\\u003c')}
    />
    {
      scholarly && (
        <>
          <meta name="citation_title" content={d.title} />
          {d.authors.map((author) => (
            <meta name="citation_author" content={author.name} />
          ))}
          <meta
            name="citation_publication_date"
            content={d.date.toISOString().slice(0, 10).replaceAll('-', '/')}
          />
          {d.venue && <meta name="citation_journal_title" content={d.venue} />}
          {d.doi && <meta name="citation_doi" content={d.doi} />}
          {d.pdf && <meta name="citation_pdf_url" content={d.pdf} />}
        </>
      )
    }
  </Fragment>
  <article class="wrap article-shell" data-pagefind-body>
    <a class="back-link" href="/writing/">← All writing</a>
    <header class="article-header">
      <p class="article-kind">
        {d.kind}{d.status && ` / ${d.status}`}{d.venue && ` / ${d.venue}`}
      </p><h1>
        {d.title}
      </h1><p class="article-deck">{d.description}</p><div class="article-meta">
        {
          d.authors.map((author) => (
            <span>
              {author.orcid ? <a href={author.orcid}>{author.name}</a> : author.name}
              {author.affiliation && (
                <span class="author-affiliation"> · {author.affiliation}</span>
              )}
            </span>
          ))
        }
        <time datetime={d.date.toISOString()}>{dateLabel(d.date)}</time><span
          >{readingTime(post.body)} min read</span
        >
        {d.updated && <span>Updated {dateLabel(d.updated)}</span>}
      </div>{
        artifacts.length > 0 && (
          <div class="artifact-links">
            {artifacts.map((artifact) => (
              <a href={artifact.url}>{artifact.label} ↗</a>
            ))}
          </div>
        )
      }
    </header>
    <div class="article-grid">
      <aside class="article-toc" aria-label="Table of contents">
        <p>On this page</p><nav>
          {
            toc.map((heading) => (
              <a href={`#${heading.slug}`} class:list={{ 'toc-secondary': heading.depth === 3 }}>
                {heading.text}
              </a>
            ))
          }
        </nav>
      </aside>
      <div class="article-body">
        {
          toc.length > 0 && (
            <details class="mobile-toc">
              <>
                <summary>On this page</summary>
                <nav aria-label="Article sections">
                  {toc.map((heading) => (
                    <a href={`#${heading.slug}`}>{heading.text}</a>
                  ))}
                </nav>
              </>
            </details>
          )
        }
        {
          d.abstract && (
            <aside class="abstract" aria-labelledby="abstract-heading">
              <>
                <h2 id="abstract-heading">{scholarly ? 'Abstract' : 'In brief'}</h2>
                <p>{d.abstract}</p>
              </>
            </aside>
          )
        }
        <div class="prose"><Content /></div>
        <div class="article-end">
          <div class="article-tags">
            {d.tags.map((tag) => <a href={`/writing/?q=${encodeURIComponent(tag)}`}>{tag}</a>)}
          </div><button class="article-action" data-print hidden>Print / Save PDF ↗</button>
        </div>
        <details class="citation-box">
          <summary>Cite this {scholarly ? 'research' : 'article'}</summary><pre
            id="bibtex">{citation}</pre><div class="citation-controls">
            <button class="article-action" data-copy-citation hidden>Copy BibTeX</button><a
              class="article-action"
              href={`/citations/${post.id}.bib`}
              download>Download .bib ↓</a
            >
          </div><p class="citation-status" role="status" id="citation-status"></p>
        </details>
        {
          (d.version || d.license) && (
            <p class="article-version">
              {d.version && `Version ${d.version}`}
              {d.version && d.license && ' · '}
              {d.license}
            </p>
          )
        }
      </div>
    </div>
  </article>
  <script>
    const printButton = document.querySelector<HTMLButtonElement>('[data-print]');
    if (printButton) {
      printButton.hidden = false;
      printButton.addEventListener('click', () => window.print());
    }
    const citationButton = document.querySelector<HTMLButtonElement>('[data-copy-citation]');
    if (citationButton) {
      citationButton.hidden = false;
      citationButton.addEventListener('click', async () => {
        const status = document.querySelector('#citation-status')!;
        try {
          await navigator.clipboard.writeText(document.querySelector('#bibtex')!.textContent || '');
          status.textContent = 'BibTeX copied.';
        } catch {
          status.textContent =
            'Copy is unavailable. Select the citation above or download the .bib file.';
        }
      });
    }
    document.querySelectorAll<HTMLPreElement>('.prose pre').forEach((pre) => {
      const code = pre.querySelector('code');
      if (!code) return;
      const wrapper = document.createElement('div');
      wrapper.className = 'code-wrapper';
      pre.before(wrapper);
      wrapper.append(pre);
      const button = document.createElement('button');
      button.className = 'copy-code';
      button.textContent = 'Copy';
      button.setAttribute('aria-label', 'Copy code');
      button.addEventListener('click', async () => {
        try {
          await navigator.clipboard.writeText(code.textContent || '');
          button.textContent = 'Copied';
        } catch {
          button.textContent = 'Select to copy';
          const range = document.createRange();
          range.selectNodeContents(code);
          const selection = window.getSelection();
          selection?.removeAllRanges();
          selection?.addRange(range);
        }
        setTimeout(() => {
          button.textContent = 'Copy';
        }, 2000);
      });
      wrapper.append(button);
    });
    const links = [...document.querySelectorAll<HTMLAnchorElement>('.article-toc a')];
    const sections = links
      .map((link) => document.getElementById(decodeURIComponent(link.hash.slice(1))))
      .filter((s): s is HTMLElement => !!s);
    if (sections.length && 'IntersectionObserver' in window) {
      const observer = new IntersectionObserver(
        (entries) => {
          const visible = entries.find((entry) => entry.isIntersecting);
          if (visible)
            links.forEach((link) => {
              if (decodeURIComponent(link.hash.slice(1)) === visible.target.id)
                link.setAttribute('aria-current', 'true');
              else link.removeAttribute('aria-current');
            });
        },
        { rootMargin: '-5% 0px -75% 0px' },
      );
      sections.forEach((section) => observer.observe(section));
    }
  </script>
</Base>
