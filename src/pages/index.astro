---
import Base from '../layouts/Base.astro';
import Crow from '../components/Crow.astro';
import ContextArt from '../components/ContextArt.astro';
import Icon from '../components/Icon.astro';
import { publishedPosts, postUrl, shortDate, readingTime } from '../lib/content';
const posts = await publishedPosts();
const featured = posts.find((p) => p.data.featured) || posts[0];
---

<Base>
  <div class="wrap">
    <section class="home-hero" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="eyebrow"><span class="status-dot"></span> AN OPEN NOTEBOOK · YANGYI LIU</p><h1
          id="intro-title"
        >
          Biology, intelligence,<br />and a little<br /><em>curiosity.</em>
        </h1><p class="hero-description">
          I’m Yangyi. I explore how AI can help us understand living systems. Along the way, I make
          art, feed crows, and write things down.
        </p><a class="text-link" href="/about/">A little more about me <Icon name="arrow" /></a>
      </div>
      <div class="hero-illustration">
        <Crow /><span class="specimen-label"><span>FIG. 01</span> A fellow curious mind.</span>
      </div>
    </section>
    <section class="latest-section" aria-labelledby="latest-heading">
      <div class="section-heading">
        <h2 id="latest-heading">From the notebook</h2><a
          class="text-link small-link"
          href="/writing/">All writing <Icon name="arrow" size={18} /></a>
      </div>
      {
        featured && (
          <a class="featured-post" href={postUrl(featured)}>
            <div class="featured-art">
              <ContextArt />
            </div>
            <div class="featured-copy">
              <>
                <p class="eyebrow">
                  {featured.data.kind} <span class="meta-divider">/</span>{' '}
                  {shortDate(featured.data.date)}
                </p>
                <h3>{featured.data.title}</h3>
                <p>{featured.data.description}</p>
                <span class="read-label">
                  Read the article{' '}
                  <>
                    <Icon name="arrow" size={18} />
                    <span>{readingTime(featured.body)} min read</span>
                  </>
                </span>
              </>
            </div>
          </a>
        )
      }
    </section>
    <section class="current-section" aria-labelledby="current-heading">
      <div>
        <p class="eyebrow">CURRENTLY EXPLORING</p><h2 id="current-heading">
          AI for the messy,<br /><em>living world.</em>
        </h2>
      </div><div class="current-copy">
        <p>
          I’m developing agentic systems for bioinformatic analysis at AmadeusBio.ai. My background
          is in molecular and cell biology at UC San Diego.
        </p><p>
          I’m especially interested in what happens when new tools meet the open questions of
          biological research.
        </p><a class="text-link" href="https://www.amadeusbio.ai"
          >AmadeusBio.ai <Icon name="external" size={19} /></a>
      </div>
    </section>
    <section class="interests-section" aria-labelledby="interests-heading">
      <div class="section-heading">
        <h2 id="interests-heading">Beyond the work</h2><span class="quiet-note"
          >A few recurring interests</span>
      </div><div class="interest-grid">
        <a href="/about/#art"
          ><span class="interest-number">01 /</span><h3>
            Art & illustration <Icon name="external" />
          </h3><p>Drawing, visual novels, and the stories we find ourselves in.</p></a
        >
        <a href="/about/#artificial-intelligence"
          ><span class="interest-number">02 /</span><h3>
            Learning in the open <Icon name="external" />
          </h3><p>New tools, unexpected connections, and asking better questions.</p></a
        >
        <a href="/about/#crows"
          ><span class="interest-number">03 /</span><h3>
            The neighborhood crows <Icon name="external" />
          </h3><p>A reason to step outside and see the world a little differently.</p></a
        >
      </div>
    </section>
  </div>
</Base>
