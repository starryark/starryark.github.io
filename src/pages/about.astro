---
import { getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Icon from '../components/Icon.astro';
import { site } from '../site';
const page = await getEntry('pages', 'about');
if (!page) throw new Error('About page content is missing');
const { Content, headings } = await render(page);
---

<Base title="About" description={page.data.description}>
  <div class="wrap page-grid">
    <div class="page-content">
      <header class="page-heading"><h1>About</h1></header>
      <div class="prose about-prose"><Content /></div>
      <ul class="social-links" aria-label="Contact and social profiles">
        <li><a href={`mailto:${site.email}`}><Icon name="email" size={16} /> Email</a></li>
        {
          site.links.map(({ label, href }) => (
            <li>
              <a href={href} rel="me">
                <BrandIcon name={label} />
                {label}
              </a>
            </li>
          ))
        }
      </ul>
    </div>
    <aside class="page-toc" aria-label="On this page">
      <p>On this page</p>
      <nav>
        {
          headings
            .filter((heading) => heading.depth === 2)
            .map((heading) => <a href={`#${heading.slug}`}>{heading.text}</a>)
        }
      </nav>
      <img
        class="about-photo"
        src="/assets/img/avatar.jpg"
        alt="Yangyi Liu’s profile artwork"
        width="144"
        height="144"
      />
    </aside>
  </div>
</Base>
